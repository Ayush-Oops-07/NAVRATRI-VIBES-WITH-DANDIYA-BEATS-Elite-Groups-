# Google Analytics 4 (GA4) Configuration
# Replace with your actual GA4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
VITE_GA_MEASUREMENT_ID=

# Google Search Console Site Verification Meta Tag (e.g., string from google-site-verification)
NEXT_PUBLIC_GSC_VERIFICATION=
VITE_GSC_VERIFICATION=

# Production Site URL (Optional, for canonical tags and sitemaps)
# e.g., https://dandiyanightmotihari.in
NEXT_PUBLIC_SITE_URL=
VITE_SITE_URL=
